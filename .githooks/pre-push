#!/bin/sh
# Ghost Labs pre-push (DE-38, DE-49). Never bypass with --no-verify.
# 1. One item, one branch: refuses a second unmerged claude/ branch for the same board key (DE-38).
# 2. Release tags need a passing scan report and a passing panel review for that version (DE-49).
# 3. Security scan: the full static scan of every commit being pushed; any finding blocks (DE-49).
dir=$(dirname "$0")
# Homebrew and cargo tools, also when git runs from an app (VS Code) with a short PATH.
PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.cargo/bin:$PATH"; export PATH
shas=""
while read -r _ local_sha remote_ref _; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac   # a deletion
  case "$remote_ref" in
    refs/heads/claude/*) sh "$dir/check-duplicate-branch.sh" "$remote_ref" || exit 1 ;;
    refs/tags/*)
      tag=${remote_ref#refs/tags/}
      ver=$(printf '%s\n' "$tag" | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1)
      if [ -n "$ver" ]; then
        sh "$dir/check-release-evidence.sh" "*" "$ver" "$local_sha" || { echo "pre-push: tag $tag refused (DE-49)." >&2; exit 1; }
      fi ;;
  esac
  case " $shas " in *" $local_sha "*) ;; *) shas="$shas $local_sha" ;; esac
done
for s in $shas; do
  python3 "$dir/security-scan.py" --rev "$s" || exit 1
done
exit 0
